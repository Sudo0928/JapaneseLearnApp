DATABASE_URL=postgresql://postgres:your_password@localhost:5432/japanese_learn_dev
PORT=3000
NODE_ENV=production

# Use the Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID_WEB=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Add mobile client IDs only if you will expose the same backend to mobile apps.
# GOOGLE_CLIENT_ID_ANDROID=
# GOOGLE_CLIENT_ID_IOS=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: required for admin endpoints in production.
# ADMIN_API_KEY=replace-with-a-long-random-secret
