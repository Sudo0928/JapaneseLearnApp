{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-learn-app/schemas/review-event/v1",
  "title": "ReviewEvent",
  "description": "Append-only review event emitted during study sessions.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "event_id",
    "user_id",
    "card_id",
    "ts",
    "prompt_type",
    "correct",
    "rt_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9]{8}_[a-zA-Z0-9_-]+$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^u_[a-zA-Z0-9_-]+$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^c_[a-zA-Z0-9_-]+$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^it_[a-zA-Z0-9_-]+$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_type": {
      "type": "string",
      "enum": [
        "SURFACE_TO_MEANING",
        "MEANING_TO_SURFACE",
        "SURFACE_TO_READING",
        "MCQ",
        "CLOZE",
        "LISTENING"
      ]
    },
    "correct": {
      "type": "boolean"
    },
    "rt_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "hint_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "error_type": {
      "type": "string",
      "enum": [
        "NONE",
        "READING_CONFUSION",
        "FORM_SIMILAR",
        "MEANING_NEAR",
        "NO_RECALL",
        "TYPO"
      ],
      "default": "NONE"
    },
    "device": {
      "type": "string",
      "enum": ["IOS", "ANDROID", "WEB", "UNKNOWN"],
      "default": "UNKNOWN"
    },
    "offline": {
      "type": "boolean",
      "default": false
    },
    "network_state": {
      "type": "string",
      "enum": ["offline", "wifi", "cellular", "unknown"],
      "default": "unknown"
    },
    "last_successful_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "queue_depth": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    }
  },
  "examples": [
    {
      "event_id": "evt_20260305_000001",
      "user_id": "u_pseudo_8f0c2b",
      "card_id": "c_it_KEIKEN_STR",
      "item_id": "it_KEIKEN",
      "ts": "2026-03-05T10:21:34+09:00",
      "prompt_type": "SURFACE_TO_READING",
      "correct": false,
      "rt_ms": 4820,
      "attempt_count": 1,
      "hint_level": 1,
      "confidence": 0.6,
      "error_type": "READING_CONFUSION",
      "device": "ANDROID",
      "offline": true,
      "network_state": "offline",
      "last_successful_sync_at": "2026-03-05T10:03:00+09:00",
      "queue_depth": 3,
      "schema_version": "1.0.0"
    }
  ]
}
