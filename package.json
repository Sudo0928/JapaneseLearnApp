{
  "name": "japanese-learn-app",
  "version": "0.1.0",
  "private": true,
    "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/mobile",
    "packages/web"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=packages/backend",
    "mobile": "npm run start --workspace=packages/mobile",
    "web": "npm run web --workspace=packages/mobile",
    "dashboard": "npm run dev --workspace=packages/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
